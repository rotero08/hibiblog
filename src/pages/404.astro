---
import Layout from '../layouts/Layout.astro';
---

<Layout title="回送 · Página no encontrada · Hibi" description="Esta página no existe.">
  <div class="japan-hub lost">
    {/* 踏切, a level crossing: bars down, lamps alternating */}
    <div class="fumikiri" aria-hidden="true">
      <span class="pole"><i></i><i></i></span>
      <span class="bar"></span>
    </div>
    <p class="board" aria-hidden="true"><span>回送</span><small>Fuera de servicio</small></p>
    <h1 class="guide-page-title">Este tren no para aquí.</h1>
    <p class="guide-page-desc">
      <span class="jp">この電車には、ご乗車になれません。</span><br />
      La página que buscabas se ha movido o nunca estuvo en el horario. (Error 404.)
    </p>
    <p><a class="back as-link" href="/">Volver a la estación principal →</a></p>
  </div>
</Layout>

<style>
  .lost {
    display: grid;
    justify-items: start;
    gap: 1.4rem;
    padding-top: clamp(3rem, 10vh, 6rem);
  }
  /* 方向幕, the printed roll sign on the front of a train: this one is 回送, out of service */
  .board {
    display: grid;
    justify-items: center;
    gap: 0.7rem;
    padding: 1.2rem 2.4rem 1rem;
    border: 3px solid var(--sheet-ink);
    border-radius: 8px;
    background: var(--sheet);
    color: var(--sheet-ink);
    font: 600 clamp(3rem, 12vw, 5.5rem) / 1 'Noto Serif JP', serif;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    box-shadow: var(--paper-shadow);
  }
  .board small {
    font: 600 11.5px / 1.4 'Inter', sans-serif;
    letter-spacing: 3px;
    text-indent: 3px;
    text-transform: uppercase;
    color: var(--ink-n);
  }
  .jp {
    font-family: 'Noto Serif JP', serif;
    font-style: normal;
    color: var(--ink);
    letter-spacing: 2px;
  }
  .back {
    font-size: 11px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--stamp);
    border-bottom: 1px solid currentColor;
  }
  .fumikiri {
    position: relative;
    width: min(100%, 26rem);
    height: 4.2rem;
  }
  .pole {
    position: absolute;
    left: 0.6rem;
    bottom: 0;
    width: 6px;
    height: 100%;
    background: repeating-linear-gradient(0deg, #e9b93a 0 9px, #1c1814 9px 18px);
  }
  .pole i {
    position: absolute;
    top: 0.4rem;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #f0453a;
    box-shadow: 0 0 14px #f0453a;
    animation: lamp 0.9s steps(1) infinite;
  }
  .pole i:first-child {
    left: -19px;
  }
  .pole i:last-child {
    left: 10px;
    animation-delay: 0.45s;
  }
  .bar {
    position: absolute;
    left: 0.9rem;
    bottom: 0.9rem;
    width: calc(100% - 1rem);
    height: 7px;
    border-radius: 3px;
    background: repeating-linear-gradient(90deg, #e9b93a 0 18px, #1c1814 18px 36px);
    transform-origin: 0 50%;
    animation: bar 1.4s var(--spring) both 0.3s;
  }
  @keyframes bar {
    from {
      rotate: -72deg;
    }
  }
  @keyframes lamp {
    50% {
      opacity: 0.15;
      box-shadow: none;
    }
  }
</style>
