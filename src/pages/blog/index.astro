---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import { SHELVES } from '../../lib/posts';

// Every .md / .mdx file in src/content/blog/ is listed here, newest first.
const shelf = SHELVES.blog;
---

<Layout title={`${shelf.title} · Hibi`} description="Crónicas personales y observaciones de la vida cotidiana en Japón.">
  <div class="japan-hub">
    <PageHeader eyebrow="Blog" title={shelf.title} ja={shelf.ja} color={shelf.color}>
      Crónicas personales, observaciones de la vida cotidiana, y todo lo que no encaja en una guía estructurada. Subjetivo por diseño.
    </PageHeader>
    <PostList shelf="blog" />
  </div>
</Layout>
