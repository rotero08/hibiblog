    /* Light. The cover throws a shadow on the page it comes down on (late in
       the turn, and gone early when it lifts), and each face of the turning
       board is darker the further it leans away from flat. */
    .side-r::after,
    .book.is-3d .side-l > .leaf::after,
    .cover::after {
      content: '';
