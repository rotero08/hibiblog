        rgba(0, 0, 0, 0.16) 55.3% 55.9%,
        transparent 56.2% 87%,
        rgba(0, 0, 0, 0.16) 87.3% 87.9%,
        rgba(255, 255, 255, 0.05) 88.2% 88.8%,
        transparent 89.1% 96.6%,
