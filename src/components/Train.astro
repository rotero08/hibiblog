---
/**
 * Train: a three-car local (各駅停車), drawn from the side. It pulls in from the
 * right when the page loads, waits at the platform, and every so often heads
 * back out the way it came: a shuttle on a line with one train. Head and tail
 * lamps swap with the direction of travel. Purely decorative.
 *
 * Position it with a wrapper; the SVG sits on the wrapper's bottom edge.
 */

const CAR = 124;
const GAP = 5;
const cars = [0, 1, 2].map((i) => i * (CAR + GAP));
const width = CAR * 3 + GAP * 2;
---

<svg class="train" viewBox={`-50 -7 ${width + 100} 41`} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="beam-l" x1="1" x2="0">
      <stop offset="0" stop-color="#ffd98a" stop-opacity="0.5"></stop>
      <stop offset="1" stop-color="#ffd98a" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="beam-r" x1="0" x2="1">
      <stop offset="0" stop-color="#ffd98a" stop-opacity="0.5"></stop>
      <stop offset="1" stop-color="#ffd98a" stop-opacity="0"></stop>
    </linearGradient>

    <g id="car-glass">
      <rect x="14.5" y="8.5" width="4.8" height="8.5" rx="0.8"></rect>
      <rect x="20.7" y="8.5" width="4.8" height="8.5" rx="0.8"></rect>
      <rect x="32" y="8.5" width="17" height="7.5" rx="1"></rect>
      <rect x="53.5" y="8.5" width="17" height="7.5" rx="1"></rect>
      <rect x="75" y="8.5" width="17" height="7.5" rx="1"></rect>
      <rect x="98.5" y="8.5" width="4.8" height="8.5" rx="0.8"></rect>
      <rect x="104.7" y="8.5" width="4.8" height="8.5" rx="0.8"></rect>
    </g>

    <g id="car-under">
      <rect x="9" y="25.6" width="106" height="2.2"></rect>
      <rect x="45" y="25.6" width="34" height="4.6" rx="1"></rect>
      <rect x="12" y="27.4" width="22" height="2.8" rx="1.4"></rect>
      <rect x="90" y="27.4" width="22" height="2.8" rx="1.4"></rect>
      <circle cx="17.5" cy="30.6" r="2.8"></circle>
      <circle cx="28.5" cy="30.6" r="2.8"></circle>
      <circle cx="95.5" cy="30.6" r="2.8"></circle>
      <circle cx="106.5" cy="30.6" r="2.8"></circle>
    </g>

    <g id="car-doors" fill="none">
      <rect x="13.2" y="6.6" width="13.6" height="18.4" rx="1"></rect>
      <rect x="97.2" y="6.6" width="13.6" height="18.4" rx="1"></rect>
    </g>
  </defs>

  {/* headlight beams (only visible at night) */}
  <path class="beam beam--l" d="M1 21 L-48 11 V33 Z" fill="url(#beam-l)"></path>
  <path class="beam beam--r" d={`M${width - 1} 21 L${width + 48} 11 V33 Z`} fill="url(#beam-r)"></path>

  {
    cars.map((x, i) => (
      <g transform={`translate(${x} 0)`}>
        {i > 0 && <rect class="under" x={-GAP - 0.5} y="19.5" width={GAP + 1} height="3" />}
        <use href="#car-under" class="under" />
        {i === 1 && <path class="panto" d="M56 4 l6 -7 l6 7 M57.5 -3 h9" fill="none" />}
        <rect class="under" x={i === 1 ? 78 : 40} y="1.6" width="30" height="3" rx="1" />
        <g transform={i === 2 ? `translate(${CAR} 0) scale(-1 1)` : undefined}>
          {i === 1 ? (
            <rect class="body" x="0" y="4" width={CAR} height="22" rx="3" />
          ) : (
            <path class="body" d={`M10 4 H${CAR - 3} a3 3 0 0 1 3 3 V23 a3 3 0 0 1 -3 3 H3.5 A3.5 3.5 0 0 1 0 22.5 V15 Q0 5.5 10 4 Z`} />
          )}
          <rect class="stripe" x={i === 1 ? 0.6 : 0.8} y="18.6" width={CAR - (i === 1 ? 1.2 : 1.4)} height="2.6" />
          {i !== 1 && <path class="glass" d="M3.2 15.5 V11.5 Q3.4 7.6 9 7.2 H10.6 V15.5 Z" />}
        </g>
        <use href="#car-doors" class="doors" />
        <use href="#car-glass" class="glass" />
      </g>
    ))
  }

  {/* lamps: white leads, red trails */}
  <circle class="lamp lamp--head lamp--arrive" cx="3" cy="22" r="1.5"></circle>
  <circle class="lamp lamp--tail lamp--depart" cx="3" cy="22" r="1.5"></circle>
  <circle class="lamp lamp--tail lamp--arrive" cx={width - 3} cy="22" r="1.5"></circle>
  <circle class="lamp lamp--head lamp--depart" cx={width - 3} cy="22" r="1.5"></circle>
</svg>

<style>
  .train {
    --loop: 54s;
    --body: #fbf7ee;
    --edge: var(--ink);
    --glass: var(--ink-soft);
    --under: var(--ink);
    --glow: none;
    display: block;
    width: clamp(15rem, 30vw, 24rem);
    overflow: visible;
    pointer-events: none;
    animation: train-run var(--loop) infinite both;
  }
  :global(:root[data-theme='dark']) .train {
    --body: #3a2c44;
    --edge: #6d5879;
    --glass: #ffd98a;
    --under: #0d0810;
    --glow: drop-shadow(0 0 5px rgba(255, 205, 120, 0.6));
  }
  .body {
    fill: var(--body);
    stroke: var(--edge);
    stroke-width: 1.1;
  }
  .stripe {
    fill: var(--stamp);
  }
  .glass {
    fill: var(--glass);
    filter: var(--glow);
  }
  .under {
    fill: var(--under);
  }
  .doors {
    stroke: var(--edge);
    stroke-width: 0.7;
    opacity: 0.55;
  }
  .panto {
    stroke: var(--edge);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lamp--head {
    fill: #fff6d6;
    filter: drop-shadow(0 0 3px #fff2c0);
  }
  .lamp--tail {
    fill: #f0453a;
    filter: drop-shadow(0 0 3px #f0453a);
  }
  .lamp--arrive,
  .beam--l {
    animation: lamps-arrive var(--loop) infinite both step-end;
  }
  .lamp--depart,
  .beam--r {
    animation: lamps-depart var(--loop) infinite both step-end;
  }
  .beam {
    display: none;
  }
  :global(:root[data-theme='dark']) .beam {
    display: block;
  }
  /* arrive braking from the right, dwell, leave the way it came */
  @keyframes train-run {
    0% {
      translate: 110vw 0;
      animation-timing-function: cubic-bezier(0.1, 0.6, 0.15, 1);
    }
    7% {
      translate: 0 0;
    }
    76% {
      translate: 0 0;
      animation-timing-function: cubic-bezier(0.6, 0, 0.9, 0.5);
    }
    86%,
    100% {
      translate: 110vw 0;
    }
  }
  @keyframes lamps-arrive {
    0% {
      opacity: 1;
    }
    74% {
      opacity: 0;
    }
  }
  @keyframes lamps-depart {
    0% {
      opacity: 0;
    }
    74% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .train,
    .lamp,
    .beam {
      animation: none !important;
    }
    .lamp--depart,
    .beam--r {
      opacity: 0;
    }
  }
</style>
