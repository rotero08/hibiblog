---
/**
 * KippuTicket — a Japanese train-ticket (切符 / kippu) styled card.
 *
 * Provides the full ticket "chrome": rounded card with punched circular
 * notches on the sides, a bottom rectangular notch, optional dashed
 * perforation stub, optional ✦ validation stars and an optional station
 * ink-stamp (駅スタンプ / eki-stamp). The actual ticket content is supplied
 * through the default slot, keeping the component reusable for the vocabulary
 * widget, the hub entry ticket, and future CMS-driven tickets.
 *
 * @example
 * ```mdx
 * <KippuTicket stars stub stubText="乗車券" serial="7702" stamp={{ title: '到着', date: '2026.06.12' }}>
 *
 * Lo que va dentro del boleto se escribe en Markdown.
 *
 * </KippuTicket>
 * ```
 */
interface Props {
  /** Render the three ✦ "validation" stars in the top-left corner. @default false */
  stars?: boolean;
  /** Render the vertical dashed perforation ("stub") line near the right edge. @default false */
  stub?: boolean;
  /**
   * Optional station ink-stamp printed top-right. Provide the inner text lines;
   * omit the whole object to render no stamp.
   */
  stamp?: {
    /** Large kanji line, e.g. "到着". */
    title: string;
    /** Small caption line, e.g. "乗車記念". */
    subtitle?: string;
    /** Monospaced date line, e.g. "2026.06.12". */
    date?: string;
  };
  /** Vertical print on the stub (needs `stub`), e.g. "乗車券". */
  stubText?: string;
  /** Serial number printed under the stub text, e.g. "7702". */
  serial?: string;
  /** Lean towards the pointer on hover. @default true */
  tilt?: boolean;
  /** Extra class names merged onto the ticket (layout / theme modifiers). */
  class?: string;
  /** When set, the entire ticket becomes a link pointing to this URL. */
  href?: string;
  /**
   * Force a full page load instead of a client-side View Transition for the
   * link. Use this when linking to a Starlight docs route, which lives outside
   * the custom-pages router. @default false
   */
  reload?: boolean;
}

const { stars = false, stub = false, stamp, stubText, serial, tilt = true, class: className = '', href, reload = false } = Astro.props;
const Tag = href ? 'a' : 'div';
// Spread (rather than a literal attribute) so the static checker doesn't warn
// about data-astro-reload on the dynamic tag — it is only set on the <a> form.
const linkAttrs = href && reload ? { 'data-astro-reload': true } : {};
---

<Tag
  class:list={['kippu-ticket', className, { 'as-link': href }]}
  href={href}
  data-tilt={tilt ? '' : undefined}
  data-inview
  {...linkAttrs}
>
  {/* the paper: its own layer, so the side notches are real cut-outs */}
  <span class="kippu-paper" aria-hidden="true"><i></i></span>
  {/* 入鋏, the punch mark, clipped out when the ticket comes into view */}
  <span class="kippu-notch" aria-hidden="true"></span>
  {stub && <span class="ticket-stub-border" aria-hidden="true"></span>}
  {
    stub && stubText && (
      <span class="kippu-stub-text" aria-hidden="true">
        {stubText}
        {serial && <b>{serial}</b>}
      </span>
    )
  }
  {
    stars && (
      <span class="kippu-stars" aria-hidden="true">
        <span>✦</span>
        <span>✦</span>
        <span>✦</span>
      </span>
    )
  }
  {
    stamp && (
      <div class="eki-stamp-seal">
        <svg viewBox="0 0 100 100" width="96" height="96">
          <circle cx="50" cy="50" r="46" class="eki-stamp-circle" stroke-width="2" stroke-dasharray="140 2 60 4 20 2" />
          <circle cx="50" cy="50" r="41" class="eki-stamp-circle" stroke-width="1" />
          <text x="50" y="44" class="eki-stamp-text" font-size="18" text-anchor="middle" font-weight="600">
            {stamp.title}
          </text>
          {stamp.subtitle && (
            <text x="50" y="61" class="eki-stamp-text" font-size="11" text-anchor="middle" letter-spacing="1">
              {stamp.subtitle}
            </text>
          )}
          {stamp.date && (
            <text x="50" y="75" class="eki-stamp-date" text-anchor="middle">
              {stamp.date}
            </text>
          )}
        </svg>
      </div>
    )
  }
  <slot />
</Tag>
