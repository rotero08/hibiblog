---
import KippuTicket from './KippuTicket.astro';

/**
 * VocabFeature — the "word of the week" (今週の単語) widget.
 *
 * A vocabulary card built on top of {@link KippuTicket}: a dark header with an
 * icon and labels, then the headword, reading, meaning and an example sentence.
 * Every textual field is a typed prop so it maps directly to CMS fields.
 */
interface Props {
  /** Eyebrow label above the word. @default 'Palabra de la semana' */
  label?: string;
  /** Japanese eyebrow shown on the right of the header. @default '今週の単語' */
  labelJa?: string;
  /** The headword in Japanese (kanji/kana), e.g. "侘寂". */
  word: string;
  /** Reading in romaji or kana, e.g. "wabi-sabi". */
  reading: string;
  /** Short meaning / gloss, e.g. "la belleza en la imperfección y lo efímero". */
  meaning: string;
  /** Example sentence written in Japanese. */
  exampleJa?: string;
  /** Translation of the example sentence. */
  exampleEs?: string;
  /** Extra class names merged onto the underlying ticket. */
  class?: string;
}

const {
  label = 'Palabra de la semana',
  labelJa = '今週の単語',
  word,
  reading,
  meaning,
  exampleJa,
  exampleEs,
  class: className = '',
} = Astro.props;

const ticketClass = ['vocab-feature', className].filter(Boolean).join(' ');
const hasExample = Boolean(exampleJa || exampleEs);
---

<KippuTicket stars class={ticketClass}>
  <div class="vocab-header">
    <div class="vocab-header-left">
      <svg class="vocab-header-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3" y="4" width="18" height="15" rx="4"></rect>
        <rect x="5" y="7" width="14" height="6" rx="1"></rect>
        <circle cx="8" cy="16" r="1.5" fill="currentColor"></circle>
        <circle cx="16" cy="16" r="1.5" fill="currentColor"></circle>
        <path d="M 4,21 L 2,23 M 20,21 L 22,23"></path>
      </svg>
      <span>{label}</span>
    </div>
    <span class="vocab-jp">{labelJa}</span>
  </div>

  <div class="vocab-body">
    <div class="vocab-word">{word}</div>
    <div class="vocab-reading">{reading}</div>
    <div class="vocab-meaning">{meaning}</div>
    {
      hasExample && (
        <>
          <div class="ticket-stub-border-horizontal"></div>
          <div class="vocab-example">
            {exampleJa && <div class="jp-line">{exampleJa}</div>}
            {exampleEs}
          </div>
        </>
      )
    }
  </div>
</KippuTicket>
