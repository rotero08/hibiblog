---
/**
 * InfoList — a vertical list of accent-bordered info blocks, each with a bold
 * title and a body paragraph. Used for the step-by-step blocks in the guides
 * (e.g. the arrival guide) so that MDX can describe them with typed data
 * instead of raw HTML.
 */
interface InfoItem {
  /** Bold heading for this entry. */
  title: string;
  /** Body text describing the entry. */
  body: string;
}

interface Props {
  /** The titled info blocks to render, in order. */
  items: InfoItem[];
  /** Accent colour for the left borders. @default 'var(--green)' */
  accent?: string;
}

const { items, accent = 'var(--green)' } = Astro.props;
---

<div class="info-list">
  {
    items.map((item) => (
      <div class="info-block" style={`border-left-color:${accent}`}>
        <strong class="info-block-title">{item.title}</strong>
        <p class="info-block-body">{item.body}</p>
      </div>
    ))
  }
</div>

<style>
  .info-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 1rem 0 1.8rem;
  }
  .info-block {
    border-left: 3px solid var(--green);
    padding-left: 1.2rem;
  }
  .info-block-title {
    color: var(--ink);
    display: block;
    margin-bottom: 0.3rem;
  }
  .info-block-body {
    font-size: 13.5px;
    color: var(--ink-soft);
    line-height: 1.7;
  }
</style>
