---
/**
 * EkiStamp: 駅スタンプ, the rubber stamp kept by the ticket gates of Japanese
 * stations for travellers to collect. One per guide chapter; the outline depends
 * on the line. Ink colour follows the line too (red for Japanese, green for
 * arrival), with the rough-ink filter from /scripts/hibi.js when available.
 */
import { stationCode, type Line } from '../data/guides';

interface Props {
  line: Line;
  /** Index of the station within the line. */
  index: number;
}
const { line, index } = Astro.props;
const station = line.stations[index];
const code = stationCode(line, index);
const uid = `st-${line.id}-${index}`;
const octagon = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2 + Math.PI / 8;
  return `${(100 + Math.cos(a) * 96).toFixed(1)},${(100 + Math.sin(a) * 96).toFixed(1)}`;
}).join(' ');
---

<svg class:list={['eki', 'ink', `eki--${line.id}`]} viewBox="0 0 200 200" role="img" aria-label={`Sello de ${station.ja} (${code})`}>
  <defs>
    <path id={`${uid}-t`} d="M 34 100 A 66 66 0 0 1 166 100"></path>
    <path id={`${uid}-b`} d="M 22 100 A 78 78 0 0 0 178 100"></path>
  </defs>
  <g fill="none" stroke="currentColor">
    {line.id === 'japones' ? <circle cx="100" cy="100" r="93" stroke-width="5" /> : <polygon points={octagon} stroke-width="5" stroke-linejoin="round" />}
    <circle cx="100" cy="100" r="83" stroke-width="1.4"></circle>
    <circle cx="100" cy="100" r="53" stroke-width="1.4"></circle>
  </g>
  <g fill="currentColor">
    <text class="eki-ring" font-size="13.5"><textPath href={`#${uid}-t`} startOffset="50%" text-anchor="middle">日々・{line.ja}</textPath></text>
    <text class="eki-code" font-size="12.5"><textPath href={`#${uid}-b`} startOffset="50%" text-anchor="middle">{code} ★ 乗車記念 ★ {code}</textPath></text>
    <text class="eki-mark" x="100" y="121" font-size="60" text-anchor="middle">{station.mark}</text>
    <text class="eki-name" x="100" y="141" font-size="10.5" text-anchor="middle">{station.ja}駅</text>
  </g>
</svg>

<style>
  .eki {
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--ink-n);
  }
  .eki--llegada {
    color: var(--ink-l);
  }
  .eki-ring,
  .eki-name {
    font-family: 'Noto Serif JP', serif;
    font-weight: 600;
    letter-spacing: 0.2em;
  }
  .eki-code {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 500;
    letter-spacing: 0.1em;
  }
  .eki-mark {
    font-family: 'Noto Serif JP', serif;
    font-weight: 600;
  }
</style>
