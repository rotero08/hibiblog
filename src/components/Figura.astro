---
/**
 * Figura: an image of the arrival guide, with its caption and its source. The
 * caption is what is written between the tags.
 *
 * Images live in `src/assets/llegada/` and are referred to by file name, so the
 * MDX needs no imports and Astro still optimises them (WebP, srcset, intrinsic
 * size). Pass several names to set them side by side, for instance the two
 * faces of a card.
 *
 * `tipo="documento"` (the default) mounts the image on a sheet of paper that
 * stays light in the dark theme, because forms and cards have white
 * backgrounds; `tipo="foto"` shows a photograph edge to edge.
 *
 * @example
 * ```mdx
 * <Figura img="kioto-atardecer" tipo="foto" alt="Kioto al atardecer, con la pagoda de Kiyomizu-dera" fuente="SSAJ">
 * El pie de foto, en Markdown.
 * </Figura>
 *
 * <Figura
 *   img={['tarjeta-residencia-frente', 'tarjeta-residencia-reverso']}
 *   alt={['Anverso de la tarjeta de residencia.', 'Reverso de la tarjeta.']}
 *   fuente="Agencia de Servicios de Inmigración de Japón"
 * >
 * Las dos caras de la tarjeta.
 * </Figura>
 * ```
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** File name, without extension, of one image in src/assets/llegada/, or several. */
  img: string | string[];
  /** Text alternative for each image, in the same order as `img`. */
  alt: string | string[];
  /** Who the image belongs to. Always shown. */
  fuente: string;
  /**
   * How the image is mounted: `documento` on a sheet of paper that stays light
   * at night (forms, cards), `foto` edge to edge. @default 'documento'
   */
  tipo?: 'documento' | 'foto';
}

const { img, alt, fuente, tipo = 'documento' } = Astro.props;

const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/llegada/*.{png,jpg,jpeg,webp}', {
  eager: true,
});
const porNombre = new Map(
  Object.entries(archivos).map(([ruta, mod]) => [ruta.split('/').pop()!.replace(/\.[^.]+$/, ''), mod.default]),
);

const nombres = [img].flat();
const alts = [alt].flat();
if (alts.length !== nombres.length) {
  throw new Error(`<Figura>: ${nombres.length} imagen(es) pero ${alts.length} texto(s) alternativo(s).`);
}

const MAX = 1600;
const imagenes = nombres.map((nombre, i) => {
  const meta = porNombre.get(nombre);
  if (!meta) {
    throw new Error(`<Figura>: no existe "${nombre}" en src/assets/llegada/.`);
  }
  const ancho = Math.min(meta.width, MAX);
  return {
    meta,
    alt: alts[i],
    ancho,
    // never ask for more pixels than the file has
    anchos: [...[480, 800, 1200].filter((w) => w < ancho), ancho],
  };
});

// what the image actually occupies: the text column, or half of it when paired
const sizes =
  imagenes.length > 1 ? '(min-width: 35rem) 21rem, 90vw' : '(min-width: 50rem) 44rem, 92vw';
---

<figure class:list={['figura', 'not-content', `figura-${tipo}`]}>
  <div class="figura-marco" data-cuantas={imagenes.length}>
    {
      imagenes.map(({ meta, alt, ancho, anchos }) => (
        <Image src={meta} alt={alt} width={ancho} widths={anchos} sizes={sizes} style={`--natural:${meta.width}px`} />
      ))
    }
  </div>
  <figcaption>
    <span class="figura-num" lang="ja" aria-hidden="true">図</span>
    <span class="figura-pie"><slot /></span>
    <span class="figura-fuente">Imagen: {fuente}</span>
  </figcaption>
</figure>

<style>
  .figura {
    margin: 2rem 0;
    counter-increment: figura;
  }

  .figura-marco {
    position: relative;
    display: grid;
    gap: 0.8rem;
    justify-items: center;
  }
  .figura-marco[data-cuantas='2'] {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .figura-marco :global(img) {
    display: block;
    width: 100%;
    /* small originals (a card scanned at 512 px) are not blown up */
    max-width: var(--natural);
    height: auto;
  }

  /* a document: mounted on paper, held by a strip of tape */
  .figura-documento .figura-marco {
    padding: 1.4rem 1.1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: #f7f3ea;
    box-shadow: var(--lift, 0 10px 30px rgba(0, 0, 0, 0.08));
  }
  .figura-documento .figura-marco::before {
    content: '';
    position: absolute;
    top: -0.55rem;
    left: 50%;
    width: 5.5rem;
    height: 1.1rem;
    background: color-mix(in srgb, var(--stamp) 42%, transparent);
    translate: -50% 0;
    rotate: -2deg;
    /* torn ends */
    clip-path: polygon(3% 0, 97% 0, 100% 50%, 97% 100%, 3% 100%, 0 50%);
  }
  .figura-documento .figura-marco :global(img) {
    border-radius: 2px;
  }
  :global([data-theme='dark']) .figura-documento .figura-marco {
    background: #e9e2d6;
  }
  :global([data-theme='dark']) .figura-documento .figura-marco :global(img) {
    filter: brightness(0.94);
  }

  /* a photograph */
  .figura-foto .figura-marco :global(img) {
    max-width: 100%;
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: var(--lift, 0 10px 30px rgba(0, 0, 0, 0.08));
  }

  figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.7rem;
    align-items: baseline;
    margin-top: 0.8rem;
    padding: 0 0.2rem;
    font-family: 'Inter', sans-serif;
  }
  .figura-num {
    grid-row: 1 / span 2;
    align-self: start;
    padding: 0.05rem 0.4rem;
    border: 1px solid currentColor;
    border-radius: 3px;
    color: var(--stamp);
    font: 600 11px / 1.6 'Noto Serif JP', serif;
    letter-spacing: 1px;
    white-space: nowrap;
  }
  .figura-num::after {
    content: ' ' counter(figura);
    font-family: 'JetBrains Mono', monospace;
  }
  .figura-pie {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.6;
  }
  /* a caption written on its own lines in MDX arrives wrapped in a paragraph */
  .figura-pie :global(p) {
    display: inline;
    margin: 0;
  }
  .figura-pie :global(a) {
    color: var(--stamp);
  }
  .figura-fuente {
    grid-column: 2;
    color: var(--muted);
    font: 500 10.5px / 1.6 'JetBrains Mono', monospace;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }
</style>
