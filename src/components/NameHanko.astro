---
/**
 * NameHanko: the owner's line of the stamp book. Type your name, see it as a
 * 判子 (name seal) in katakana, and stamp it to sign the book.
 *
 * Foreign names are written in katakana, by sound, and src/lib/katakana.ts
 * makes that conversion as you type. It is only an approximation, so there is
 * a second box with the result in it: whoever already has their name in
 * katakana (on a residence card, say) writes it there, as it is, and the seal
 * uses that. Katakana can also go straight into the first box.
 *
 * While you type the seal is only pencilled in. Pressing "Estampar" (or Enter)
 * inks it and saves the name in this browser, and from then on the book, the
 * panel in the top bar and the "stamp collected" notice use it (see markOwner
 * in /scripts/hibi.js).
 *
 * The name is a game, not personal data to fill in, so the two boxes carry no
 * `autocomplete` hint and no `name`: browsers and password managers have
 * nothing to offer there (`autocomplete="given-name"` is what made Bitwarden
 * open its menu on the first box). The data-* attributes on them are the "leave
 * this alone" marks of Bitwarden, 1Password, LastPass and Dashlane, in that order.
 */
---

<form class="nh is-empty" data-name-hanko novalidate>
  <div class="nh-form">
    <label class="section-label" for="nh-input">持ち主 · Esta libreta es de</label>
    <div class="nh-field">
      <input
        id="nh-input"
        type="text"
        maxlength="24"
        placeholder="Escribe tu nombre"
        autocapitalize="words"
        enterkeyhint="done"
        spellcheck="false"
        autocomplete="off"
        data-bwignore="true"
        data-1p-ignore="true"
        data-lpignore="true"
        data-form-type="other"
        data-nh-input
      />
      <button class="nh-go" type="submit" data-nh-go disabled>Estampar</button>
    </div>

    <label class="section-label nh-kana-label" for="nh-kana">カタカナ · En katakana</label>
    <input
      id="nh-kana"
      class="nh-kana-input"
      type="text"
      lang="ja"
      maxlength="20"
      placeholder="Se rellena solo"
      autocapitalize="off"
      enterkeyhint="done"
      spellcheck="false"
      autocomplete="off"
      data-bwignore="true"
      data-1p-ignore="true"
      data-lpignore="true"
      data-form-type="other"
      data-nh-kana-input
    />
    <p class="nh-status" role="status" data-nh-status>
      Escribe tu nombre y se pasa a katakana por cómo suena. Si ya tienes tu katakana, escríbelo en la segunda casilla.
    </p>
  </div>

  <div class="nh-result">
    <span class="nh-seal ink" data-nh-seal aria-hidden="true"><span class="nh-col"><span>名</span><span>前</span></span></span>
    <div class="nh-reading">
      <p class="nh-kana" lang="ja" data-nh-kana>なまえ</p>
      <p class="nh-note" data-nh-note>名前 (namae) significa "nombre".</p>
    </div>
  </div>
</form>

<script>
  import { nameToKana, fromKana, sealColumns, type Katakana } from '../lib/katakana';

  const KEY = 'hibi-name';
  const KANA_KEY = 'hibi-name-kana';
  const HELP =
    'Escribe tu nombre y se pasa a katakana por cómo suena. Si ya tienes tu katakana, escríbelo en la segunda casilla.';

  const read = (key: string) => {
    try {
      return localStorage.getItem(key) ?? '';
    } catch {
      return '';
    }
  };
  const write = (key: string, value: string) => {
    try {
      if (value) localStorage.setItem(key, value);
      else localStorage.removeItem(key);
    } catch {
      /* private mode: the name just lasts for this visit */
    }
  };

  function setup(box: HTMLFormElement) {
    if (box.dataset.ready) return;
    box.dataset.ready = '1';
    const input = box.querySelector<HTMLInputElement>('[data-nh-input]')!;
    const kanaInput = box.querySelector<HTMLInputElement>('[data-nh-kana-input]')!;
    const button = box.querySelector<HTMLButtonElement>('[data-nh-go]')!;
    const status = box.querySelector<HTMLElement>('[data-nh-status]')!;
    const seal = box.querySelector<HTMLElement>('[data-nh-seal]')!;
    const kanaLine = box.querySelector<HTMLElement>('[data-nh-kana]')!;
    const note = box.querySelector<HTMLElement>('[data-nh-note]')!;

    let saved = { name: read(KEY).trim(), kana: read(KANA_KEY) };
    // has the owner written the katakana themselves? Until then the second box
    // just mirrors the conversion of the first.
    let own = false;

    // only touch the text when it changes, so it is announced once
    const say = (el: HTMLElement, text: string) => {
      if (el.textContent !== text) el.textContent = text;
    };

    /** What the two boxes add up to right now. */
    function typed() {
      const name = input.value.trim();
      const converted = name ? nameToKana(name) : null;
      const written = own ? fromKana(kanaInput.value) : null;
      const kana: Katakana | null = written?.kana ? written : converted?.kana ? converted : null;
      return {
        // with only the katakana box filled in, the katakana is the name
        name: name || written?.kana || '',
        kana,
        byOwner: Boolean(written?.kana) && written?.kana !== converted?.kana,
      };
    }

    // the seal: one <span> per column, one per sound inside it
    function drawSeal(columns: string[][]) {
      seal.replaceChildren(
        ...columns.map((sounds) => {
          const column = document.createElement('span');
          column.className = 'nh-col';
          column.append(
            ...sounds.map((kana) => {
              const sound = document.createElement('span');
              sound.textContent = kana;
              return sound;
            }),
          );
          return column;
        }),
      );
      const rows = Math.max(...columns.map((c) => c.join('').length));
      seal.style.setProperty('--rows', String(rows));
      seal.style.setProperty('--cols', String(columns.length));
    }
    // each kana with how it is read underneath
    function drawReading(name: Katakana) {
      kanaLine.replaceChildren(
        ...name.parts.map(([kana, romaji]) => {
          const cell = document.createElement('span');
          const k = document.createElement('b');
          const r = document.createElement('small');
          k.textContent = kana;
          r.textContent = romaji;
          cell.append(k, r);
          return cell;
        }),
      );
    }

    function render() {
      const now = typed();
      const state = !now.name
        ? 'empty'
        : !now.kana
          ? 'unreadable'
          : now.name === saved.name && now.kana.kana === saved.kana
            ? 'signed'
            : 'draft';
      box.classList.toggle('is-empty', state === 'empty' || state === 'unreadable');
      box.classList.toggle('is-draft', state === 'draft');
      box.classList.toggle('is-signed', state === 'signed');

      if (now.kana) {
        drawSeal(sealColumns(now.kana));
        drawReading(now.kana);
      } else {
        drawSeal([['名', '前']]);
        say(kanaLine, 'なまえ');
      }

      if (state === 'draft') {
        say(button, saved.name ? 'Estampar de nuevo' : 'Estampar');
        button.disabled = false;
        say(status, 'Vista previa. Pulsa Estampar o la tecla Enter para firmar la libreta.');
        say(
          note,
          now.byOwner
            ? 'El katakana que escribiste tú.'
            : 'Así sonaría tu nombre en katakana. La conversión es automática y aproximada.',
        );
      } else if (state === 'signed') {
        say(button, 'Estampado');
        button.disabled = true;
        say(status, `Libreta a nombre de ${saved.name}. Se guarda solo en este navegador.`);
        say(
          note,
          now.byOwner
            ? 'Tu nombre en katakana, tal como lo escribiste.'
            : 'Así suena tu nombre en katakana. La conversión es automática y aproximada.',
        );
      } else {
        // nothing to stamp: either a fresh book, or the owner is erasing the name
        const erasing = Boolean(saved.name) && state === 'empty';
        say(button, erasing ? 'Quitar nombre' : 'Estampar');
        button.disabled = !erasing;
        say(
          status,
          state === 'unreadable'
            ? 'Usa letras, o escribe el katakana en la segunda casilla.'
            : erasing
              ? `La libreta sigue a nombre de ${saved.name} hasta que pulses Quitar nombre.`
              : HELP,
        );
        say(note, '名前 (namae) significa "nombre".');
      }
    }

    function press() {
      seal.classList.remove('is-pressing');
      void seal.offsetWidth;
      seal.classList.add('is-pressing');
    }

    // With a Japanese keyboard, Enter first confirms the word being composed.
    // That Enter must not stamp the book (Safari sends it after the composition ends).
    let composing = false;
    for (const el of [input, kanaInput]) {
      el.addEventListener('compositionstart', () => (composing = true));
      el.addEventListener('compositionend', () => setTimeout(() => (composing = false), 0));
    }

    box.addEventListener('submit', (event) => {
      event.preventDefault();
      if (composing) return;
      const now = typed();
      if (now.name && !now.kana) return;
      saved = { name: now.name, kana: now.kana?.kana ?? '' };
      write(KEY, saved.name);
      write(KANA_KEY, saved.kana);
      render();
      if (saved.name) press();
      document.dispatchEvent(new CustomEvent('hibi:owner'));
    });

    // the name box: the katakana box follows it, unless the owner wrote their own.
    // Emptying the name starts over, katakana included.
    input.addEventListener('input', () => {
      if (!input.value.trim()) own = false;
      if (!own) kanaInput.value = input.value.trim() ? nameToKana(input.value).kana : '';
      render();
    });
    // the katakana box: from the first key on, it belongs to the owner
    kanaInput.addEventListener('input', () => {
      own = kanaInput.value.trim() !== '';
      render();
    });
    // on leaving it: tidy what was written (full-width kana, nothing else), or,
    // if nothing Japanese was, go back to following the name
    kanaInput.addEventListener('blur', () => {
      const written = fromKana(kanaInput.value).kana;
      if (written) {
        kanaInput.value = written;
      } else {
        own = false;
        kanaInput.value = input.value.trim() ? nameToKana(input.value).kana : '';
      }
      render();
    });

    input.value = saved.name;
    // a name saved before the katakana was stored alongside it
    if (saved.name && !saved.kana) {
      saved.kana = nameToKana(saved.name).kana;
      write(KANA_KEY, saved.kana);
      document.dispatchEvent(new CustomEvent('hibi:owner'));
    }
    kanaInput.value = saved.kana;
    own = Boolean(saved.kana) && saved.kana !== nameToKana(saved.name).kana;
    render();
  }

  const init = () => document.querySelectorAll<HTMLFormElement>('[data-name-hanko]').forEach(setup);
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .nh {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 1.5rem 2.5rem;
    align-items: center;
  }
  .nh-form .section-label {
    margin-bottom: 0.6rem;
    color: var(--sheet-soft);
  }
  .nh-field {
    display: flex;
    align-items: flex-end;
    gap: 0.9rem;
    max-width: 28rem;
  }
  .nh input {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    padding: 0.7rem 0.2rem 0.6rem;
    border: 0;
    border-bottom: 2px solid var(--sheet-line);
    border-radius: 0;
    background: transparent;
    color: var(--sheet-ink);
    font: 500 1.35rem 'Lora', serif;
    transition: border-color 0.25s;
  }
  .nh input::placeholder {
    color: var(--sheet-soft);
    font-style: italic;
    opacity: 0.75;
  }
  .nh input:focus {
    outline: none;
    border-bottom-color: var(--stamp);
  }
  .nh-go {
    flex: none;
    padding: 0.62rem 1.05rem;
    border: 1.5px solid var(--stamp);
    border-radius: 4px;
    background: var(--stamp);
    color: var(--on-stamp);
    font: 600 11px 'Inter', sans-serif;
    letter-spacing: 2px;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.25s, color 0.25s, border-color 0.25s, translate 0.4s var(--spring), box-shadow 0.3s;
  }
  .nh-go:hover:not(:disabled) {
    translate: 0 -2px;
    box-shadow: 0 10px 18px -10px var(--stamp);
  }
  .nh-go:active:not(:disabled) {
    translate: 0 0;
  }
  .nh-go:disabled {
    border-color: var(--sheet-line);
    background: transparent;
    color: var(--sheet-soft);
    cursor: default;
  }
  /* signed: the button stays as a quiet receipt */
  .nh.is-signed .nh-go {
    border-style: dashed;
    border-color: var(--ink-n);
    color: var(--ink-n);
  }
  .nh.is-signed .nh-go::before {
    content: '済 ';
    font-family: 'Noto Serif JP', serif;
    letter-spacing: 0;
  }
  /* the katakana box: smaller, it is the conversion made editable */
  .nh-kana-label {
    margin-top: 1.1rem;
  }
  .nh .nh-kana-input {
    display: block;
    max-width: 28rem;
    padding: 0.45rem 0.2rem 0.4rem;
    border-bottom-width: 1.5px;
    font: 500 1.15rem 'Noto Serif JP', serif;
    letter-spacing: 2px;
  }
  .nh .nh-kana-input::placeholder {
    font: italic 400 1rem 'Lora', serif;
    letter-spacing: 0;
  }
  .nh-status {
    max-width: 28rem;
    min-height: 2.6em;
    margin-top: 0.75rem;
    font-size: 13px;
    line-height: 1.6;
    color: var(--sheet-soft);
  }
  .nh.is-signed .nh-status {
    color: var(--sheet-ink);
  }

  .nh-result {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    min-width: 0;
  }
  /* the seal: kana set vertically, columns running right to left */
  .nh-seal {
    --size: 5.8rem;
    --rows: 2;
    --cols: 1;
    /* the room inside the frame, shared out between the rows (or the columns,
       when there are more of those than rows) */
    --room: calc(var(--size) * 0.82 - 6px);
    --fs: calc(var(--room) / max(var(--rows) * 1.04, var(--cols) * 1.3));
    flex: none;
    box-sizing: border-box;
    display: flex;
    flex-direction: row-reverse;
    justify-content: center;
    align-items: stretch;
    gap: calc(var(--fs) * 0.12);
    width: var(--size);
    height: var(--size);
    padding: calc(var(--size) * 0.09) 0;
    border: 3px solid var(--ink-n);
    border-radius: 16%;
    color: var(--ink-n);
    font: 600 var(--fs) / 1.04 'Noto Serif JP', serif;
    letter-spacing: 0;
    rotate: -5deg;
    transition: opacity 0.3s, border-color 0.3s;
  }
  /* each column spreads its sounds over the full height, as carved seals do */
  .nh-seal :global(.nh-col) {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
  }
  .nh-seal :global(.nh-col > span) {
    flex: none;
    writing-mode: vertical-rl;
    white-space: nowrap;
  }
  /* nothing typed: an empty slot. Typing: pencilled in. Stamped: inked. */
  .nh.is-empty .nh-seal {
    border-style: dashed;
    border-width: 2px;
    border-color: var(--sheet-line);
    color: var(--sheet-soft);
    opacity: 0.8;
  }
  .nh.is-draft .nh-seal {
    border-style: dashed;
    opacity: 0.62;
  }
  .nh.is-draft :global(.ink),
  .nh.is-empty :global(.ink) {
    filter: none;
  }
  .nh-seal.is-pressing {
    animation: nh-press 0.6s var(--ease-out);
  }
  @keyframes nh-press {
    0% {
      scale: 1.7;
      opacity: 0;
      rotate: -18deg;
    }
    50% {
      scale: 0.93;
      opacity: 1;
    }
    75% {
      scale: 1.03;
    }
  }
  .nh-reading {
    min-width: 0;
  }
  .nh-kana {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    font: 500 1.5rem / 1.2 'Noto Serif JP', serif;
    color: var(--sheet-ink);
  }
  .nh.is-empty .nh-kana {
    color: var(--sheet-soft);
  }
  .nh-kana :global(span) {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
  }
  .nh-kana :global(b) {
    font-weight: 500;
  }
  .nh-kana :global(small) {
    font: 500 0.7rem 'JetBrains Mono', monospace;
    letter-spacing: 0.5px;
    color: var(--ink-n);
  }
  .nh-note {
    margin-top: 0.6rem;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--sheet-soft);
  }
  @media (max-width: 760px) {
    .nh {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .nh-field {
      flex-wrap: wrap;
    }
    .nh-go {
      width: 100%;
    }
  }
</style>
