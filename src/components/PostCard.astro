---
/**
 * PostCard: one post, as a link, in any of the five shapes the site lists
 * posts in. All of them are filled in from the post's own header, so writing
 * the file is enough for it to appear everywhere.
 *
 *   card     the tall card of the /blog/ and /personal/ indexes
 *   row      the compact row of the home page's blog column
 *   summary  the row with a summary on the Japan hub
 *   note     the postcard of the home page's personal notes
 *   peek     a 単語カード, the ringed word card students flip through: the Japanese
 *            term large, then the first lines of the text itself
 */
import { topicBySlug } from '../data/topics';
import { SHELVES, excerpt, monthYear, postHref, readingLabel, type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** Which of the five shapes to draw. @default 'card' */
  shape?: 'card' | 'row' | 'summary' | 'note' | 'peek';
}

const { post, shape = 'card' } = Astro.props;
const shelf = SHELVES[post.collection];
const { title, description, date, draft } = post.data;
const tag = post.data.tag ?? shelf.tag;
const href = postHref(post);
const month = monthYear(date);
const minutes = readingLabel(post);
const meta = [month, minutes].filter(Boolean).join(' · ');
const ja = post.data.ja;
// the card takes the colour of its tag, when it has one
const ink = topicBySlug(post.data.topic)?.color ?? shelf.color;
---

{
  shape === 'card' && (
    <a class="archive-card as-link" href={href} data-reveal>
      <div class="archive-card-top">
        <div class="jh-blog-tag" style={`color:${shelf.color}`}>
          {tag}
          {draft && <span class="post-draft">Borrador</span>}
        </div>
        <h2 class="post-title">{title}</h2>
        <p class="post-excerpt">{description}</p>
      </div>
      <div class="archive-card-bottom">
        <span class="recent-date">{meta}</span>
        <span class="archive-card-action">{shelf.read} →</span>
      </div>
    </a>
  )
}

{
  shape === 'row' && (
    <a class="blog-post-item as-link" href={href} data-reveal>
      <div class="bp-tag">
        {tag}
        {draft && <span class="post-draft">Borrador</span>}
      </div>
      <div class="bp-title">{title}</div>
      <div class="bp-meta">{meta}</div>
    </a>
  )
}

{
  shape === 'summary' && (
    <a class="jh-blog-item as-link" href={href} data-reveal>
      <div class="jh-blog-tag">
        {tag}
        {draft && <span class="post-draft">Borrador</span>}
      </div>
      <div class="jh-blog-title">{title}</div>
      <div class="jh-blog-meta">{meta}</div>
      <div class="jh-blog-excerpt">{description}</div>
    </a>
  )
}

{
  shape === 'note' && (
    <a class="personal-card as-link" href={href} data-reveal>
      <div class="pc-date">
        {month}
        {draft && <span class="post-draft">Borrador</span>}
      </div>
      <div class="pc-title">{title}</div>
      <div class="pc-excerpt">{description}</div>
    </a>
  )
}

{
  shape === 'peek' && (
    <a class="peek as-link" href={href} style={`--c:${ink}`} data-reveal>
      <span class="peek-hole" aria-hidden="true" />
      <span class="peek-tag">
        {tag}
        {draft && <span class="post-draft">Borrador</span>}
      </span>
      {ja && <span class:list={['peek-ja', { long: ja.length > 3 }]} lang="ja">{ja}</span>}
      <span class="peek-title">{title}</span>
      <span class="peek-text">{excerpt(post, 120)}</span>
      {/* only the month: a note is always a minute's read, and the card is narrow */}
      <span class="peek-meta">
        <span>{month}</span>
        <span class="peek-flip" aria-hidden="true">めくる →</span>
      </span>
    </a>
  )
}

<style>
  .archive-card .post-title {
    margin-top: 0.5rem;
  }
  .archive-card .post-excerpt {
    font-size: 13.5px;
  }
  /* shown only while developing: this one is not published yet */
  .post-draft {
    display: inline-block;
    margin-left: 0.6rem;
    padding: 0.1rem 0.45rem;
    border: 1px dashed currentColor;
    border-radius: 2rem;
    color: var(--muted);
    font: 600 9.5px / 1.5 'Inter', sans-serif;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    vertical-align: 1px;
  }

  /* ---- peek: a word card on a ring ---- */
  .peek {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 2.3rem 1.2rem 1rem 1.5rem;
    border-radius: 10px;
    /* ruled like an index card, with a coloured margin line on the left */
    background:
      linear-gradient(90deg, transparent 0.75rem, var(--c) 0.75rem, var(--c) calc(0.75rem + 2px), transparent calc(0.75rem + 2px)),
      repeating-linear-gradient(0deg, transparent 0 25px, var(--sheet-rule) 25px 26px),
      var(--sheet);
    color: var(--sheet-ink);
    /* two more cards underneath. Kept straight: tilting the card made the ruled
       lines and the edges jagged. */
    box-shadow:
      0 0 0 1px var(--sheet-rule),
      4px 4px 0 -1px var(--sheet), 4px 4px 0 0 var(--sheet-rule),
      8px 8px 0 -1px var(--sheet), 8px 8px 0 0 var(--sheet-rule),
      var(--paper-shadow);
    text-decoration: none;
    transition: translate 0.45s var(--spring), box-shadow 0.3s;
  }
  /* picked up off the stack */
  .peek:hover,
  .peek:focus-visible {
    translate: -3px -5px;
    box-shadow:
      0 0 0 1px var(--c),
      6px 7px 0 -1px var(--sheet), 6px 7px 0 0 var(--sheet-rule),
      12px 14px 0 -1px var(--sheet), 12px 14px 0 0 var(--sheet-rule),
      var(--paper-shadow);
  }
  /* the punched hole the ring goes through */
  .peek-hole {
    position: absolute;
    top: 0.7rem;
    left: 50%;
    width: 13px;
    height: 13px;
    margin-left: -6.5px;
    border-radius: 50%;
    background: var(--cream);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.35), 0 0 0 1px var(--sheet-rule);
  }
  .peek-tag {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--c);
  }
  .peek-ja {
    font: 600 2.3rem / 1.15 'Noto Serif JP', serif;
    color: var(--c);
    overflow-wrap: anywhere;
    transform-origin: 0 100%;
    transition: scale 0.45s var(--spring);
  }
  .peek-ja.long {
    font-size: 1.35rem;
    line-height: 1.3;
    letter-spacing: 1px;
  }
  .peek:hover .peek-ja {
    scale: 1.06;
  }
  .peek-title {
    font: 500 1rem / 1.35 'Lora', serif;
    color: var(--sheet-ink);
  }
  .peek-text {
    font-size: 13px;
    line-height: 1.6;
    color: var(--sheet-soft);
  }
  .peek-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 11px;
    letter-spacing: 0.5px;
    color: var(--sheet-soft);
  }
  /* めくる: to flip a card over */
  .peek-flip {
    font: 500 11px 'Noto Serif JP', serif;
    color: var(--c);
    opacity: 0;
    translate: -6px 0;
    transition: opacity 0.25s, translate 0.4s var(--spring);
  }
  .peek:hover .peek-flip,
  .peek:focus-visible .peek-flip {
    opacity: 1;
    translate: 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .peek:hover,
    .peek:focus-visible {
      translate: none;
    }
  }
</style>
