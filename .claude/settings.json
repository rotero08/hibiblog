{
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(pnpm build)",
      "Bash(pnpm check)",
      "Bash(pnpm astro check)",
      "Bash(pnpm astro build)",
      "Bash(pnpm astro sync)",
      "Bash(pnpm astro dev --port 4410*)",
      "Bash(pnpm astro preview --port 4411*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(curl -s http://127.0.0.1:441*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./.astro/**)",
      "Read(./pnpm-lock.yaml)",
      "Read(./.env*)",
      "Bash(pkill*)",
      "Bash(killall*)",
      "Bash(kill *)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf*)"
    ]
  }
}
